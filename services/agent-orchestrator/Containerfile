# Beehive Studio Agent Orchestrator — Containerized

FROM python:3.12-slim

WORKDIR /app

# Install system dependencies (for lupa/LuaJIT compilation)
RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc \
    liblua5.4-dev \
    && rm -rf /var/lib/apt/lists/*

# Install uv for fast Python package management
COPY --from=ghcr.io/astral-sh/uv:latest /uv /bin/uv

# Copy project files
COPY pyproject.toml uv.lock ./
COPY api/ ./api/
COPY agents/ ./agents/
COPY tools/ ./tools/
COPY lua/ ./lua/

# Install dependencies using uv
RUN uv sync --no-dev

# The backend runs on port 9876
EXPOSE 9876

# Healthcheck
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD curl -f http://localhost:9876/health || exit 1

# Run the FastAPI app with uvicorn
CMD ["uv", "run", "uvicorn", "api.main:app", "--host", "0.0.0.0", "--port", "9876"]
