# Beehive Studio Environment Configuration
# Copy this file to .env and fill in your values

# ─────────────────────────────────────────────────────────────
# Backend Server
# ─────────────────────────────────────────────────────────────
BEEHIVE_STUDIO_AGENT_PORT=9876

# ─────────────────────────────────────────────────────────────
# Ollama (Local LLM)
# ─────────────────────────────────────────────────────────────
OLLAMA_HOST=http://127.0.0.1:11434
BEEHIVE_STUDIO_AGENT_MODEL=baker-creative:latest
# Fallback models (comma-separated): qwen2.5:7b, mistral:7b, llama3.1:8b

# ─────────────────────────────────────────────────────────────
# LangSmith Tracing
# ─────────────────────────────────────────────────────────────
# Get your key from: https://smith.langchain.com/settings
LANGSMITH_API_KEY=
LANGSMITH_TRACING=true
LANGSMITH_PROJECT=beehive-studio-sprint1
LANGSMITH_ENDPOINT=https://api.smith.langchain.com

# ─────────────────────────────────────────────────────────────
# Baker Street Labs Integration
# ─────────────────────────────────────────────────────────────
BAKER_STREET_URL=http://localhost:3001
# BAKER_STREET_API_KEY=  # If BSL requires auth

# ─────────────────────────────────────────────────────────────
# Lua Sandbox
# ─────────────────────────────────────────────────────────────
BEEHIVE_STUDIO_LUA_MAX_MEMORY=1048576

# ─────────────────────────────────────────────────────────────
# Development
# ─────────────────────────────────────────────────────────────
RUST_LOG=info
PYTHONPATH=.

# Inference Layer
BEEHIVE_INFERENCE_PROVIDER=vllm
BEEHIVE_VLLM_URL=http://localhost:8000/v1
BEEHIVE_VLLM_MODEL=microsoft/Phi-4-mini-instruct
BEEHIVE_OLLAMA_URL=http://localhost:11434
BEEHIVE_FALLBACK_PROVIDER=ollama
