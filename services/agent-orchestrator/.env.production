# Beehive Studio Agent Orchestrator - Production Environment
# Optimized for the new Python render performance improvements

# ─────────────────────────────────────────────────────────────
# Backend Server
# ─────────────────────────────────────────────────────────────
BEEHIVE_STUDIO_AGENT_PORT=9876

# ─────────────────────────────────────────────────────────────
# Ollama (Local LLM)
# ─────────────────────────────────────────────────────────────
OLLAMA_HOST=http://127.0.0.1:11434
BEEHIVE_STUDIO_AGENT_MODEL=baker-creative:latest
# Fallback models (comma-separated): qwen2.5:7b, mistral:7b, llama3.1:8b

# ─────────────────────────────────────────────────────────────
# LangSmith Tracing
# ─────────────────────────────────────────────────────────────
# Get your key from: https://smith.langchain.com/settings
LANGSMITH_API_KEY=your_langsmith_api_key_here
LANGSMITH_TRacing=true
LANGSMITH_PROJECT=beehive-studio-optimized
LANGSMITH_ENDPOINT=https://api.smith.langchain.com

# ─────────────────────────────────────────────────────────────
# Baker Street Labs Integration
# ─────────────────────────────────────────────────────────────
BAKER_STREET_URL=http://localhost:3001
# BAKER_STREET_API_KEY=  # If BSL requires auth

# ─────────────────────────────────────────────────────────────
# Lua Sandbox
# ─────────────────────────────────────────────────────────────
BEEHIVE_STUDIO_LUA_MAX_MEMORY=1048576

# ─────────────────────────────────────────────────────────────
# OPTIMIZED RENDER PERFORMANCE CONFIGURATION
# ─────────────────────────────────────────────────────────────

# Render Job Cache Settings
RENDER_JOB_CACHE_MAX_SIZE=50
RENDER_JOB_CACHE_ENABLED=true

# Audio File Cache Settings
AUDIO_FILE_CACHE_MAX_SIZE=20
AUDIO_FILE_CACHE_ENABLED=true

# Parallel Processing Settings
RENDER_MAX_WORKERS=4
RENDER_BATCH_SIZE=2

# Memory Management Settings
MEMORY_GC_ENABLED=true
MEMORY_CACHE_CLEANUP_THRESHOLD=1000
MEMORY_MAX_DURATION_SECONDS=300

# Performance Monitoring Settings
PERFORMANCE_METRICS_ENABLED=true
PERFORMANCE_METRICS_MAX_COUNT=100
PERFORMANCE_BENCHMARK_ENABLED=true

# Watchdog Settings
WATCHDOG_ENABLED=true
WATCHDOG_MAX_RUNTIME_SECONDS=300
WATCHDOG_HEALTH_CHECK_INTERVAL=30
WATCHDOG_MAX_RESTARTS=3

# Progress Throttling Settings
PROGRESS_THROTTLE_MIN_INTERVAL=0.05
PROGRESS_THROTTLE_ENABLED=true

# ─────────────────────────────────────────────────────────────
# Production Hardening
# ─────────────────────────────────────────────────────────────
PYTHONPATH=.
RUST_LOG=info

# Security settings
ENVIRONMENT=production
DEBUG=false
LOG_LEVEL=info

# Resource limits
MAX_MEMORY_MB=2048
MAX_CPU_CORES=2

# ─────────────────────────────────────────────────────────────
# Monitoring and Logging
# ─────────────────────────────────────────────────────────────
LOG_FILE=/app/logs/beehive-studio.log
CACHE_DIR=/app/cache
TEMP_DIR=/app/temp

# Enable detailed performance logging
PERFORMANCE_LOGGING=true
CACHE_METRICS_LOGGING=true
WATCHDOG_LOGGING=true

# ─────────────────────────────────────────────────────────────
# Optimization Performance Targets
# ─────────────────────────────────────────────────────────────
# Expected improvements from the new optimizations:
# - Parallel Processing: 30-50% improvement
# - Batch Note Processing: 15-25% improvement  
# - Render Caching: 20-40% improvement
# - Memory Management: 40-60% memory reduction
# - Stem Generation: 15-20% improvement
# - Progress Throttling: 5-10% improvement
# - Audio File Caching: Significant for repeated samples
# - Combined Target: 86% performance improvement