{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Beehive Studio",
  "version": "0.1.0",
  "identifier": "studio.beehive.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "pnpm run dev",
    "beforeBuildCommand": "pnpm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Beehive Studio",
        "width": 1400,
        "height": 900,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "transparent": false,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://localhost:9876 http://127.0.0.1:9876 ws://localhost:1420; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-eval'; img-src 'self' data: asset: http: https:; media-src 'self' asset: http: https:; worker-src 'self' blob:; font-src 'self' data:;"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "rpm", "appimage"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "copyright": "Beehive Studio 2026",
    "category": "Music",
    "shortDescription": "AI Agent Music Production Environment",
    "longDescription": "Hybrid JetBrains + Ableton style desktop for multi-agent generative music with Lua scripting and local LLMs.",
    "linux": {
      "deb": {
        "depends": ["libwebkit2gtk-4.1-0", "libgtk-3-0", "libappindicator3-1"]
      }
    }
  }
}
